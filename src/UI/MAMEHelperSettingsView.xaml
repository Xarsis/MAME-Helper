<UserControl x:Class="MAMEHelper.UI.MAMEHelperSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MAMEHelper.UI"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="620">

    <UserControl.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource PopupBackgroundBrush}">
        <StackPanel Margin="20">

            <!-- ── ROM Data Source ─────────────────────────────────────── -->
            <TextBlock Text="ROM Data Source"
                       FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>

            <RadioButton x:Name="Radio_UseExe"
                         Content="Use MAME executable (mame.exe -listxml)"
                         Foreground="{DynamicResource TextBrush}"
                         IsChecked="{Binding Settings.UseListFile,
                                     Converter={StaticResource InverseBoolConverter}}"
                         Margin="0,0,0,4"/>

            <Grid Margin="18,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Settings.MameExecutablePath,
                                UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding Settings.UseListFile,
                                     Converter={StaticResource InverseBoolConverter}}"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Margin="6,0,0,0" Padding="8,2"
                        IsEnabled="{Binding Settings.UseListFile,
                                    Converter={StaticResource InverseBoolConverter}}"
                        Click="BtnBrowseMame_Click"/>
            </Grid>

            <RadioButton x:Name="Radio_UseListFile"
                         Content="Use pre-exported XML / DAT list file"
                         Foreground="{DynamicResource TextBrush}"
                         IsChecked="{Binding Settings.UseListFile}"
                         Margin="0,0,0,4"/>

            <Grid Margin="18,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Settings.ListFilePath,
                                UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding Settings.UseListFile}"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Margin="6,0,0,0" Padding="8,2"
                        IsEnabled="{Binding Settings.UseListFile}"
                        Click="BtnBrowseListFile_Click"/>
            </Grid>

            <Separator Margin="0,8,0,12"
                       Background="{DynamicResource SeparatorBrush}"/>

            <!-- ── Cache ──────────────────────────────────────────────── -->
            <TextBlock Text="Cache"
                       FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Prompt to regenerate ROM cache after"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Width="45" Margin="8,0"
                         Text="{Binding Settings.CacheAgeDaysBeforePrompt,
                                UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         Padding="2"/>
                <TextBlock Text="days  (0 = always prompt, 9999 = never)"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Separator Margin="0,0,0,12"
                       Background="{DynamicResource SeparatorBrush}"/>

            <!-- ── Media Folders ───────────────────────────────────────── -->
            <TextBlock Text="Media Folders"
                       FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>

            <!-- Cover — primary -->
            <TextBlock Text="Cover images — primary folder:"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Settings.CoverImageFolder,
                                UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Margin="6,0,0,0" Padding="8,2"
                        Click="BtnBrowseCoverFolder_Click"/>
            </Grid>

            <!-- Cover — secondary -->
            <TextBlock Text="Cover images — secondary folder (fallback):"
                       Foreground="{DynamicResource TextBrushDarker}"
                       Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Settings.CoverImageFolder2,
                                UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Margin="6,0,0,0" Padding="8,2"
                        Click="BtnBrowseCoverFolder2_Click"/>
            </Grid>

            <!-- Background — primary -->
            <TextBlock Text="Background images — primary folder:"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Settings.BackgroundImageFolder,
                                UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Margin="6,0,0,0" Padding="8,2"
                        Click="BtnBrowseBackgroundFolder_Click"/>
            </Grid>

            <!-- Background — secondary -->
            <TextBlock Text="Background images — secondary folder (fallback):"
                       Foreground="{DynamicResource TextBrushDarker}"
                       Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Settings.BackgroundImageFolder2,
                                UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Margin="6,0,0,0" Padding="8,2"
                        Click="BtnBrowseBackgroundFolder2_Click"/>
            </Grid>

            <Separator Margin="0,4,0,12"
                       Background="{DynamicResource SeparatorBrush}"/>

            <!-- ── Info note ───────────────────────────────────────────── -->
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrushDarker}"
                       FontSize="11"
                       Text="Media files must be PNG format and named exactly after the ROM name (e.g. pacman.png). The primary folder is checked first. If no match is found there, the secondary folder is checked. For clone ROMs with no match in either folder, MAME Helper falls back to the parent ROM's image." />

            <!-- ── Save / Cancel ───────────────────────────────────────── -->
            <Separator Margin="0,16,0,12"
                       Background="{DynamicResource SeparatorBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave"
                        Content="Save"
                        Width="90" Margin="0,0,8,0" Padding="8,4"
                        Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel"
                        Content="Cancel"
                        Width="90" Padding="8,4"
                        Click="BtnCancel_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
